import test from 'node:test';
import assert from 'node:assert/strict';
import {
  staffAuthorityPreparationOperation,
  staffAuthorityPreparation,
  validateStaffAuthorityDecisions,
} from './prepare-staff-authority.mjs';

const valid = () => ({
  formatVersion:1,project:'bljskfhazmnzmhkbkcev',environment:'production',
  issuer:'https://bljskfhazmnzmhkbkcev.supabase.co/auth/v1',audience:'authenticated',
  policyVersion:'operator-selected-v1',policyClientId:'operator-selected-client',
  actorId:'11111111-1111-4111-8111-111111111111',subject:'22222222-2222-4222-8222-2222222222ab',
  canPublish:false,canReview:false,moderatorEnabled:true,
  tokenValidAfter:'2026-09-23T00:00:00.000Z',notBefore:'2026-09-23T00:00:00.000Z',validUntil:'2026-12-31T00:00:00.000Z',
  maximumTotpAgeSeconds:300,observationSeconds:30,maxResponseBytes:4096,
  catalogDraftsEnabled:false,catalogReviewsEnabled:false,catalogPublicationEnabled:false,
});
const refused = action => assert.throws(action,error => error.message.includes('preparation refused') &&
  !error.message.includes('PRIVATE_CANARY') && error.cause === undefined);

test('only explicit local preparation and decision checking are accepted', () => {
  assert.equal(staffAuthorityPreparationOperation(['--prepare']),'--prepare');
  assert.equal(staffAuthorityPreparationOperation(['--check-decisions']),'--check-decisions');
  for (const args of [[],['--apply'],['--prepare','again'],['--subject','PRIVATE_CANARY']])
    refused(()=>staffAuthorityPreparationOperation(args));
});

test('preparation contains no selected permanent identity and no runnable defaults', () => {
  const value = staffAuthorityPreparation();
  assert.equal(value.runnable,false); assert.equal(value.status,'OWNER_DECISIONS_REQUIRED');
  assert.equal(value.project,'bljskfhazmnzmhkbkcev'); assert.deepEqual(value.requiredHostedMigrations,[40,77,90]);
  for (const field of ['policyVersion','policyClientId','actorId','subject','moderatorEnabled','validUntil'])
    assert.equal(value.requiredDecisions[field],null);
  assert.match(value.constraints.join(' '),/email text is not a subject identifier/);
  assert.match(value.limitations.join(' '),/No SQL generated or applied/);
});

test('an exact complete owner decision validates to a redacted local-only report', () => {
  const value = validateStaffAuthorityDecisions(JSON.stringify(valid()));
  assert.equal(value.status,'staff-authority-decisions-valid-local');
  assert.equal(value.moderatorEnabled,true); assert.equal(value.connected,false); assert.equal(value.changed,false);
  const rendered = JSON.stringify(value);
  assert.equal(rendered.includes('11111111'),false); assert.equal(rendered.includes('22222222'),false);
  assert.equal(rendered.includes('operator-selected'),false);
});

test('fixed project provider and production environment cannot be overridden', () => {
  for (const [field,replacement] of [['project','other'],['environment','staging'],['issuer','https://other.example'],['audience','anon']]) {
    const value=valid(); value[field]=replacement; refused(()=>validateStaffAuthorityDecisions(JSON.stringify(value)));
  }
});

test('identity and registry bindings must be explicit canonical distinct values', () => {
  for (const change of [
    value=>value.actorId='PRIVATE_CANARY',
    value=>value.subject=value.subject.toUpperCase(),
    value=>value.policyVersion='',
    value=>value.policyClientId='x'.repeat(257),
    value=>value.policyVersion='PRIVATE\nCANARY',
  ]) { const value=valid(); change(value); refused(()=>validateStaffAuthorityDecisions(JSON.stringify(value))); }
});

test('moderation is deliberate and catalog capability dependencies are monotonic', () => {
  for (const change of [
    value=>value.moderatorEnabled=false,
    value=>{value.catalogReviewsEnabled=true;value.catalogDraftsEnabled=false;},
    value=>{value.catalogPublicationEnabled=true;value.catalogReviewsEnabled=false;},
    value=>value.moderatorEnabled='true',
  ]) { const value=valid(); change(value); refused(()=>validateStaffAuthorityDecisions(JSON.stringify(value))); }
  const all=valid(); all.canPublish=true;all.canReview=true;all.catalogDraftsEnabled=true;
  all.catalogReviewsEnabled=true;all.catalogPublicationEnabled=true;
  assert.equal(validateStaffAuthorityDecisions(JSON.stringify(all)).catalogPublicationEnabled,true);
});

test('time and response bounds match the runtime admission policy without selecting values', () => {
  for (const change of [
    value=>value.maximumTotpAgeSeconds=0,
    value=>value.maximumTotpAgeSeconds=901,
    value=>value.observationSeconds=61,
    value=>{value.maximumTotpAgeSeconds=10;value.observationSeconds=11;},
    value=>value.maxResponseBytes=1023,
    value=>value.validUntil=value.notBefore,
    value=>value.tokenValidAfter=value.validUntil,
    value=>value.notBefore='2026-09-23T00:00:00+00:00',
  ]) { const value=valid(); change(value); refused(()=>validateStaffAuthorityDecisions(JSON.stringify(value))); }
  for (const maximumTotpAgeSeconds of [1,900]) for (const observationSeconds of [1,Math.min(60,maximumTotpAgeSeconds)]) {
    const value=valid();value.maximumTotpAgeSeconds=maximumTotpAgeSeconds;value.observationSeconds=observationSeconds;
    assert.equal(validateStaffAuthorityDecisions(JSON.stringify(value)).changed,false);
  }
});

test('missing extra duplicate malformed and oversized documents are refused without echo', () => {
  for (const field of Object.keys(valid())) { const value=valid();delete value[field];refused(()=>validateStaffAuthorityDecisions(JSON.stringify(value))); }
  for (const raw of ['', 'PRIVATE_CANARY', '[]', '{}', ' '.repeat(32769),
    JSON.stringify({...valid(),extra:'PRIVATE_CANARY'}),
    JSON.stringify(valid()).replace('{','{"formatVersion":1,')])
    refused(()=>validateStaffAuthorityDecisions(raw));
});
