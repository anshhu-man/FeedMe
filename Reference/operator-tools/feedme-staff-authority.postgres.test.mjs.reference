// Explicit real-PostgreSQL syntax/transaction check. Default test discovery
// skips it. The opt-in fixture is isolated under /private/tmp, uses trust only on
// a loopback random port, creates synthetic authority and is always stopped.
import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import net from 'node:net';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {staffAuthorityPreflightSql,staffAuthorityApplySql} from './feedme-staff-authority.mjs';

const run = (command,args,options={}) => {
  const result=spawnSync(command,args,{encoding:'utf8',timeout:120000,maxBuffer:4*1024*1024,...options});
  if(result.error||result.signal||result.status!==0) throw Error(`fixture command failed: ${path.basename(command)}`);
  return result.stdout.trim().split(/\r?\n/).filter(Boolean);
};
const freePort = () => new Promise((resolve,reject)=>{
  const server=net.createServer();server.unref();server.on('error',reject);
  server.listen(0,'127.0.0.1',()=>{const address=server.address();server.close(error=>error?reject(error):resolve(address.port));});
});

test('insert-only staff authority SQL is repeatable and conflicts fail closed on real PostgreSQL',
  {skip:process.env.FEEDME_RUN_STAFF_AUTHORITY_PG_CHECK!=='1'},async t=>{
    const bin='/opt/homebrew/opt/postgresql@15/bin';
    for(const name of ['initdb','pg_ctl','psql','postgres'])assert.ok(fs.existsSync(path.join(bin,name)));
    const fixture=fs.mkdtempSync('/private/tmp/feedme-staff-authority-pg-'),data=path.join(fixture,'data'),log=path.join(fixture,'postgres.log');
    fs.chmodSync(fixture,0o700);const port=await freePort();let started=false;
    t.after(()=>{if(started)spawnSync(path.join(bin,'pg_ctl'),['-D',data,'-m','immediate','-w','stop'],{stdio:'ignore',timeout:30000});
      fs.rmSync(fixture,{recursive:true,force:true});});
    run(path.join(bin,'initdb'),['-D',data,'--username=postgres','--auth=trust','--encoding=UTF8','--locale=C','--no-instructions']);
    run(path.join(bin,'pg_ctl'),['-D',data,'-l',log,'-o',`-h 127.0.0.1 -p ${port} -F`,'-w','start']);started=true;
    const psql=sql=>spawnSync(path.join(bin,'psql'),['-X','-qAt','-h','127.0.0.1','-p',String(port),'-U','postgres','-d','postgres','-v','ON_ERROR_STOP=1'],
      {input:sql,encoding:'utf8',timeout:120000,maxBuffer:4*1024*1024});
    const setup=`CREATE SCHEMA platform;
CREATE TABLE platform.schema_migrations(version integer PRIMARY KEY,description varchar(200) NOT NULL,checksum char(64) NOT NULL);
INSERT INTO platform.schema_migrations VALUES
(40,'staff_publication_approvals','bda1e378cf5b444845e1fa9de10df1b14c129f84771859197119e9c03e813f7a'),
(77,'staff_moderator_enrollments','7370ae2a9ad96dc639512d5c858a880661689ac11ac2f21fdb795b83f6121329'),
(90,'staff_operational_health_reader','13b093289a20928b91bbf439714a788525ea179bbe3ec52a87e5ce47e8d20b0d');\n`+
      fs.readFileSync(new URL('../server/src/main/resources/db/migration/V040__staff_publication_approvals.sql',import.meta.url),'utf8')+'\n'+
      fs.readFileSync(new URL('../server/src/main/resources/db/migration/V077__staff_moderator_enrollments.sql',import.meta.url),'utf8');
    let result=psql(setup);assert.equal(result.status,0,result.stderr);
    const decision={formatVersion:1,project:'bljskfhazmnzmhkbkcev',environment:'production',
      issuer:'https://bljskfhazmnzmhkbkcev.supabase.co/auth/v1',audience:'authenticated',policyVersion:'synthetic-policy',
      policyClientId:'synthetic-client',actorId:'11111111-1111-4111-8111-111111111111',
      subject:'22222222-2222-4222-8222-2222222222ab',canPublish:false,canReview:false,moderatorEnabled:true,
      tokenValidAfter:'2026-09-23T00:00:00.000Z',notBefore:'2026-09-23T00:00:00.000Z',validUntil:'2026-12-31T00:00:00.000Z',
      maximumTotpAgeSeconds:300,observationSeconds:30,maxResponseBytes:4096,catalogDraftsEnabled:false,
      catalogReviewsEnabled:false,catalogPublicationEnabled:false};
    const encoded=Buffer.from(JSON.stringify(decision)).toString('base64');
    const pg15=sql=>sql.replace('NOT BETWEEN 170000 AND 179999','NOT BETWEEN 150000 AND 159999');
    result=psql(pg15(staffAuthorityPreflightSql(encoded)));assert.equal(result.status,0,result.stderr);assert.equal(result.stdout.trim(),'absent');
    result=psql(pg15(staffAuthorityApplySql(encoded)));assert.equal(result.status,0,result.stderr);assert.equal(result.stdout.trim(),'applied-or-current');
    result=psql(pg15(staffAuthorityPreflightSql(encoded)));assert.equal(result.status,0,result.stderr);assert.equal(result.stdout.trim(),'current');
    result=psql(pg15(staffAuthorityApplySql(encoded)));assert.equal(result.status,0,result.stderr);assert.equal(result.stdout.trim(),'applied-or-current');
    result=psql("UPDATE staff.publication_policies SET enabled=false WHERE environment='production';");assert.equal(result.status,0,result.stderr);
    result=psql(pg15(staffAuthorityPreflightSql(encoded)));assert.equal(result.status,0,result.stderr);assert.equal(result.stdout.trim(),'conflict');
    result=psql(pg15(staffAuthorityApplySql(encoded)));assert.notEqual(result.status,0);assert.match(result.stderr,/Conflicting staff authority exists/);
    const count=psql("SELECT (SELECT count(*) FROM staff.publication_policies),(SELECT count(*) FROM staff.actors),(SELECT count(*) FROM staff.moderator_enrollments);");
    assert.equal(count.status,0,count.stderr);assert.equal(count.stdout.trim(),'1|1|1');
  });
