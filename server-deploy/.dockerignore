# A second boundary around the generated context. Never build from Career itself.
**
!Dockerfile
!.dockerignore
!feedme/
!feedme/**
!outputs/
!outputs/biteclub_blueprint/
!outputs/biteclub_blueprint/architecture/
!outputs/biteclub_blueprint/architecture/04_API_Contract.json
!outputs/biteclub_blueprint/registry/
!outputs/biteclub_blueprint/registry/screen_registry.json
**/.git
**/.git/**
**/.local
**/.local/**
**/.gradle
**/.gradle/**
**/.kotlin
**/.kotlin/**
**/build
**/build/**
**/node_modules
**/node_modules/**
**/local.properties
**/.env*
**/*.p12
**/*.jks
**/*.keystore
**/feedme-config.json
